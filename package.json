    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "14.0.0",
    "hono": "^4.6.14",
    "lucide-react": "^1.61.0",
    "motion": "^14.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
